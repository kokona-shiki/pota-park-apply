<?xml version="1.0"?>
<ruleset name="POTA Park Backend Rules" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 http://pmd.sourceforge.net/ruleset_2_0_0.xsd">

    <description>POTA Park Apply Backend PMD Ruleset</description>

    <!-- 基本规则 -->
    <rule ref="rulesets/codestyle.xml"/>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/imports.xml"/>
    <rule ref="rulesets/unusedcode.xml"/>

    <!-- 复杂度规则 -->
    <rule ref="rulesets/complexity.xml">
        <property name="reportLevel" value="5"/>
    </rule>

    <!-- 错误处理规则 -->
    <rule ref="rulesets/errorprone.xml"/>

    <!-- 排除的文件 -->
    <exclude-pattern>node_modules/**</exclude-pattern>
    <exclude-pattern>dist/**</exclude-pattern>
    <exclude-pattern>build/**</exclude-pattern>
    <exclude-pattern>migrations/**</exclude-pattern>
    <exclude-pattern>test/**</exclude-pattern>

</ruleset>
