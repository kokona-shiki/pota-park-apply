{
  "name": "pota-park-backend",
  "version": "1.0.0",
  "description": "POTA Park Apply Backend API",
  "main": "index.ts",
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "tsx index.ts",
    "start": "tsx index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "init-db": "node scripts/initDatabase.ts",
    "migrate:remove-admin-review-permissions": "node migrations/001-remove-system-admin-review-permissions.js",
    "migrate:add-notifications-table": "node migrations/014-add-notifications-table.js",
    "test-api": "node test/test-api.ts",
    "test-backend": "node scripts/test-backend.ts",
    "clean": "rm -rf node_modules pnpm-lock.yaml",
    "reinstall": "pnpm clean && pnpm install"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "fast-csv": "^5.0.2",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.13",
    "pg": "^8.11.3",
    "prisma": "^7.3.0",
    "puppeteer": "^24.34.0",
    "svg-captcha": "^1.4.0",
    "xmlbuilder2": "^3.1.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.9",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
