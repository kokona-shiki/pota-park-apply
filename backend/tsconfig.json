{  "compilerOptions": {    "target": "ES2022",    "module": "ESNext",    "moduleResolution": "bundler",    "outDir": "dist",    "rootDir": "..",    "baseUrl": ".",    "paths": {
      "@prisma/client": ["./node_modules/.prisma/client"]
    },    "allowJs": true,    "checkJs": false,    "strict": false,    "esModuleInterop": true,    "forceConsistentCasingInFileNames": true,    "skipLibCheck": true,    "resolveJsonModule": true,    "types": ["node"]  },  "include": ["**/*.ts", "**/*.d.ts", "**/*.js", "../shared/**/*.ts"]}
