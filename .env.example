# 环境配置
NODE_ENV=development

# 后端服务器配置
PORT=3001

# PostgreSQL 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pota_park
DB_USER=postgres
DB_PASSWORD=password

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS 配置
CORS_ORIGIN=http://localhost:5173

# API配置 (前端)
VITE_API_BASE_URL=http://localhost:3001/api

# 地图配置 (前端)
VITE_MAP_DEFAULT_LAT=39.9042
VITE_MAP_DEFAULT_LNG=116.4074
