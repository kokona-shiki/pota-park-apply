# =========================
# POTA Park Apply - MVP 环境变量示例
#
# 说明：
# - 本项目主要通过 Docker Compose 运行，根目录的 .env 会被 compose 自动加载，用于注入后端容器环境变量。
# - 前端在 Docker 部署下通过 Nginx 反代使用 /api，因此通常不需要配置 API_BASE_URL。
# =========================

# --------
# 后端
# --------
NODE_ENV=development
PORT=3101

# JWT（MVP 示例值，生产务必更换）
JWT_SECRET=dev-jwt-secret-change-me

# 数据库（本地直跑后端时使用；Docker Compose 下由 compose 传入并覆盖）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pota_park
DB_USER=postgres
DB_PASSWORD=password

# 初始系统管理员（首次初始化数据库时自动创建/提升）
# 注意：MVP 阶段建议先用示例值，后续上线请改为强密码并妥善保管
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_CALLSIGN=BH1ADMIN
INIT_ADMIN_PASSWORD=ChangeMe_123456

# POTA 认证加密密钥（AES-256-GCM，必须是64个字符的hex字符串）
POTA_ENCRYPTION_KEY=99fee9f689a3e9396d3b5a8a2031119f1f698dbedeefc1014e5a58a5657c8714

# --------
# 邮件服务配置（SMTP）
# --------
# SMTP 服务器地址
SMTP_HOST=smtp.qq.com

# SMTP 端口（587 为 TLS，465 为 SSL）
SMTP_PORT=587

# 是否使用 SSL（false 表示使用 TLS）
SMTP_SECURE=false

# SMTP 用户名（邮箱地址）
SMTP_USER=your-email@qq.com

# SMTP 密码（QQ邮箱请使用授权码，不是登录密码）
SMTP_PASS=your-authorization-code

# 邮件发送冷却时间（秒），默认 180 秒（3分钟）
EMAIL_SEND_COOLDOWN_SECONDS=180

# --------
# 前端（Vite）
# --------
# 当前前端代码默认直接请求 /api（Nginx 反代），这里保留示例项便于未来切换
VITE_API_BASE_URL=/api

# 地图默认中心点
VITE_MAP_DEFAULT_LAT=39.9042
VITE_MAP_DEFAULT_LNG=116.4074
